{
  "name": "ENJIGIRLING",
  "type": "engineering-knowledge-base",
  "language": "ru",
  "version": "0.3",
  "baseUrl": "https://vremennobeznika.github.io/enjigirling/",
  "description": "Редакционный инженерный справочник; не заменяет первичные нормативные и технические источники.",
  "entryPoints": {
    "humans": "index.html",
    "ai": "llms.txt",
    "guide": "knowledge-base.md",
    "aiFull": "knowledge/ai-context.md",
    "aiUserPage": "ai.html",
    "aiDownloadAll": "knowledge/sections/all.md"
  },
  "datasets": [
    {
      "id": "professions",
      "path": "data.js",
      "format": "javascript",
      "global": "window.professionsData",
      "recordId": "id",
      "page": "index.html#profession="
    },
    {
      "id": "materials",
      "path": "materials-data.js",
      "format": "javascript",
      "global": "window.engineeringMaterials",
      "recordId": "id",
      "page": "materials.html#"
    },
    {
      "id": "processes",
      "path": "processes-data.js",
      "format": "javascript",
      "global": "window.engineeringProcesses",
      "recordId": "id",
      "page": "processes.html#"
    },
    {
      "id": "dictionary",
      "path": "dictionary-data.js",
      "format": "javascript",
      "global": "dictionary",
      "recordId": "term",
      "page": "dictionary.html?q="
    },
    {
      "id": "salary-sources",
      "path": "salary-sources.js",
      "format": "javascript",
      "note": "Данные об источниках и статусах проверки; проверяйте ограничения."
    }
  ],
  "validation": {
    "status": "editorial_not_fully_verified",
    "note": "Отдельные записи могут не иметь подтверждённых источников. Не применять как инженерную спецификацию или нормативную инструкцию.",
    "auditCommand": "node scripts/audit-knowledge.cjs --json",
    "evidenceStatus": "Salary evidence contains linked observations with explicit status; not primary verification of all assertions",
    "sourceRegistry": "knowledge/source-registry.json",
    "sourceCheckCommand": "node scripts/check-evidence.cjs",
    "qualityReport": "knowledge/quality.json"
  },
  "jsonApi": {
    "index": "knowledge/search-index.json",
    "datasets": [
      "knowledge/professions.json",
      "knowledge/materials.json",
      "knowledge/processes.json",
      "knowledge/dictionary.json"
    ],
    "format": "application/json",
    "note": "Static JSON snapshots; update these when source JavaScript datasets change.",
    "graph": "knowledge/graph.json",
    "salaryEvidence": "knowledge/salary-evidence.json",
    "aiContext": "knowledge/ai-context.md"
  },
  "aiSections": {
    "manifest": "knowledge/sections/index.json",
    "allMarkdown": "knowledge/sections/all.md",
    "sectionIds": [
      "professions",
      "calendar",
      "resources",
      "dictionary",
      "learning",
      "calculators",
      "compare",
      "processes",
      "materials"
    ],
    "markdownPattern": "knowledge/sections/{sectionId}.md",
    "jsonPattern": "knowledge/sections/{sectionId}.json",
    "quality": "editorial_not_independently_verified"
  }
}
