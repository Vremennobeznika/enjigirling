{
  "name": "enjigirling-site",
  "private": true,
  "version": "1.0.0",
  "description": "Static engineering knowledge base checks",
  "scripts": {
    "test:unit": "node tests/site-check.cjs",
    "test:browser": "playwright test",
    "build:knowledge": "node scripts/build-knowledge.cjs",
    "check:knowledge": "node scripts/build-knowledge.cjs --check",
    "test:all": "node scripts/all-checks.cjs && playwright test",
    "test:static": "node scripts/all-checks.cjs",
    "check:quality": "node scripts/build-quality.cjs --check",
    "build:quality": "node scripts/build-quality.cjs",
    "test:live": "node scripts/check-live-site.cjs",
    "test:links": "node tests/external-links.cjs",
    "test:matrix": "node scripts/all-checks.cjs && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1"
  }
}
